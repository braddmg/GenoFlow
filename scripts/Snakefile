onstart:
    import logging
    logger = logging.getLogger("snakemake")
    logger.setLevel(logging.WARNING)

def detect_samples():
    """Extract unique sample stems from FASTA files in Intermediate/."""
    import glob, pathlib
    samples = []
    for ext in ["*.fasta", "*.fa", "*.fna"]:
        samples.extend([pathlib.Path(f).stem for f in glob.glob(f"Intermediate/{ext}")])
    return sorted(set(samples))

SAMPLES = detect_samples()

# Working directories
WORKDIR = pathlib.Path(os.getcwd())
OUTDIR  = WORKDIR / cfg["outdir"]
INTDIR  = WORKDIR / "Intermediate"
LOGDIR  = WORKDIR / "logs"
OUTDIR.mkdir(parents=True, exist_ok=True)
INTDIR.mkdir(parents=True, exist_ok=True)
LOGDIR.mkdir(parents=True, exist_ok=True)

cfg['scripts_dir'] = str(WORKDIR / "scripts")
cfg['edirect_dir'] = str(WORKDIR / "scripts" / "edirect")

# Helper functions
def find_fastas_from_defaults(include_intermediate=False):
    """Discover FASTA files from Data/ and optionally Intermediate/."""
    patterns = ["Data/*.fasta", "data/*.fasta", "*.fasta"]
    if include_intermediate:
        patterns.extend(["Intermediate/*.fasta", "Intermediate/*.fa", "Intermediate/*.fna"])
    files = []
    for pat in patterns:
        for f in glob.glob(pat):
            p = pathlib.Path(f).resolve()
            if p.exists():
                files.append(str(p))
    return sorted(set(files))

def copy_fastas(fasta_csv, list_path, flag_path):
    """Copy input FASTA files into Intermediate/ with sample prefixes."""
    dest = INTDIR
    dest.mkdir(exist_ok=True)

    if not cfg.get("use_ncbi_download", False):
        for f in dest.glob("*"):
            if f.is_file():
                f.unlink()

    files = []
    if fasta_csv:
        for f in fasta_csv.split(","):
            p = pathlib.Path(f.strip())
            if not p.exists():
                p = (WORKDIR / f.strip()).resolve()
            if p.exists():
                files.append(str(p))
            else:
                print(f"Warning: FASTA file not found -> {f.strip()}")
    if not files and not cfg.get("use_ncbi_download", False):
        raise SystemExit("No FASTA provided. Use --config fasta=path1,path2 or enable NCBI download (-d).")

    if files:
        for f in files:
            sample = pathlib.Path(f).stem
            dest_path = dest / f"{sample}.fasta"
            src_path = pathlib.Path(f)
            if not src_path.exists():
                src_path = (WORKDIR / f).resolve()
            if src_path.exists() and src_path.is_file() and src_path.stat().st_size > 0:
                with open(src_path) as inp, open(dest_path, 'w') as out:
                    for line in inp:
                        if line.startswith('>'):
                            out.write(f">{sample}_{line[1:]}")
                        else:
                            out.write(line)
            else:
                print(f"Warning: FASTA file not found or empty -> {src_path}")

        with open(list_path, "w") as out:
            out.write("\n".join(files) + "\n")
    else:
        with open(list_path, "w") as out:
            out.write("")

    pathlib.Path(flag_path).write_text("collected\n")


def combine_fastas(out_fa):
    """Concatenate all FASTA files from Intermediate/ into single combined file."""
    out = pathlib.Path(out_fa)
    out.parent.mkdir(parents=True, exist_ok=True)
    patterns = ["*.fasta", "*.fa", "*.fna"]
    files = []
    for pat in patterns:
        files.extend(glob.glob(str(INTDIR / pat)))
    files = sorted(set(files))
    if not files:
        raise SystemExit("No sequence files in Intermediate/. Ensure NCBI download or local FASTA present.")
    with open(out, "w") as OUT:
        for f in files:
            with open(f) as IN:
                txt = IN.read().rstrip()
                if not txt.endswith("\n"):
                    txt += "\n"
                OUT.write(txt)

def generate_individual_sequence_names(combined_fasta, output_map):
    """Extract and rename individual sequences: SAMPLE_NODENUMBER_LXXXK_CYYY."""
    name_map = {}
    
    with open(combined_fasta) as f:
        for line in f:
            if line.startswith('>'):
                header = line[1:].strip()
                match = re.search(r'NODE_(\d+)_length_(\d+)_cov_([\d.]+)', header)
                if match:
                    node_num = match.group(1)
                    length = int(match.group(2))
                    cov = float(match.group(3))
                    
                    sample_match = re.match(r'(\w+)_NODE_', header)
                    if sample_match:
                        sample_name = sample_match.group(1)
                    else:
                        sample_name = "UNKNOWN"
                    
                    length_kb = length // 1000
                    cov_int = int(cov)
                    new_id = f"{sample_name}_NODE{node_num}_L{length_kb}k_C{cov_int}"
                    name_map[header] = new_id

    with open(output_map, 'w') as f:
        for orig, new in name_map.items():
            f.write(f"{orig}\t{new}\n")
    
    return len(name_map)

def rename_sequences_in_gff(gff_file, name_map_file, output_gff):
    """Replace sequence IDs in GFF file using mapping from TSV."""
    # Load name map
    name_map = {}
    with open(name_map_file) as f:
        for line in f:
            orig, new = line.rstrip('\n').split('\t')
            name_map[orig] = new
    
    # Process GFF
    with open(gff_file) as inp, open(output_gff, 'w') as out:
        for line in inp:
            if line.startswith('#'):
                out.write(line)
            else:
                parts = line.rstrip('\n').split('\t')
                if len(parts) >= 1:
                    seqid = parts[0]
                    if seqid in name_map:
                        parts[0] = name_map[seqid]
                    out.write('\t'.join(parts) + '\n')
                else:
                    out.write(line)


def _get_sample_stems():
    """Return sorted unique sample names from FASTA files."""
    files = []
    if cfg.get("fasta"):
        files = [s.strip() for s in str(cfg["fasta"]).split(",") if s.strip()]
    elif cfg.get("use_ncbi_download", False):
        files = find_fastas_from_defaults(include_intermediate=True)
    stems = [pathlib.Path(f).stem for f in files]
    return sorted(set(stems))

SAMPLES = _get_sample_stems()

