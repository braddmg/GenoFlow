# Configuration defaults and initialization
config = globals().get("config", {})
config_defaults = {
    "mode": "bacteria",            # bacteria or fungi
    "outdir": "results",            # output directory
    "threads": 4,                   # number of threads
    "genomes": "Data/genomes.txt",  # NCBI accessions file
    "DNA_mode": False,              # False=protein, True=DNA
    "use_ncbi_download": False,     # enable NCBI download
    "use_raxml": False,             # False=IQ-TREE, True=RAxML
    "run_ani": False,               # ANI analysis
}
for key, value in config_defaults.items():
    if key not in config:
        config[key] = value
cfg = config

# Convert string booleans from config to boolean type
def to_bool(val):
    if isinstance(val, bool):
        return val
    if isinstance(val, str):
        return val.lower() in ("true", "yes", "1", "on")
    return bool(val)

cfg["run_ani"] = to_bool(cfg.get("run_ani", False))
cfg["use_ncbi_download"] = to_bool(cfg.get("use_ncbi_download", False))
cfg["use_raxml"] = to_bool(cfg.get("use_raxml", False))
cfg["DNA_mode"] = to_bool(cfg.get("DNA_mode", False))

# Format timestamp for logging
from datetime import datetime
def timestamp():
    return datetime.now().strftime("%H:%M:%S")


if workflow.cores:
    cfg["threads"] = workflow.cores  

import os, glob, shutil, pathlib, subprocess, re

# Validate fungi mode requires 4+ genomes
if cfg.get("mode") == "fungi":
    genomes_file = cfg.get("genomes", "Data/genomes.txt")
    n_genomes = 0
    
    if os.path.exists(genomes_file):
        with open(genomes_file) as f:
            n_genomes = sum(1 for line in f if line.strip() and not line.startswith("#"))
    
    if n_genomes < 4:
        raise ValueError(
            f"[GenFlow ERROR] Fungi mode requires at least 4 genomes.\n"
            f"Found: {n_genomes} genomes in {genomes_file}\n"
            f"Please add more genomes or use bacteria mode (mode=bacteria)."
        )

