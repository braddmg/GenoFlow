elif cfg["mode"] == "fungi":
    # Fungi workflow: UFCG profiling and phylogenomic tree construction
    rule run_ufcg:
        """Profile fungal genomes with UFCG and build phylogenomic tree."""
        input:
            name_map="results/name_map.tsv"
        output:
            profiles=directory("results/ufcg/profiles"),
            tree_dir=directory("results/ufcg/trees"),
            aln="results/aligned.fasta",
            faa="results/ufcg/core_genes.faa",
            fna="results/ufcg/core_genes.fna"
        shell:
            r"""
            set -euo pipefail
            mkdir -p {output.profiles} {output.tree_dir} logs results/ufcg
            echo "[GenFlow] UFCG: profiling fungal genomes" >> logs/ufcg.log
            
            shopt -s nullglob
            FILES=(Intermediate/*.fna Intermediate/*.fasta Intermediate/*.fa)
            CNT=0; for f in "${{FILES[@]}}"; do [ -f "$f" ] && CNT=$((CNT+1)); done
            N=$CNT
            echo "[GenFlow] [$(date +%H:%M:%S)] Found $N fungal genomes, profiling with UFCG..."
            
            i=0
            for f in "${{FILES[@]}}"; do
                [ -f "$f" ] || continue
                i=$((i+1))
                sample=$(basename "$f")
                sample="${{sample%.fna}}"
                sample="${{sample%.fasta}}"
                sample="${{sample%.fa}}"
                echo "[GenFlow] [UFCG] [${i}/${N}] Profiling $sample"
                workdir="results/ufcg/$sample"
                mkdir -p "$workdir"
                ln -sf "$(realpath "$f")" "$workdir/$(basename "$f")"
                
                if ! conda run -n genflow ufcg profile -i "$workdir" -o "{output.profiles}" -s PRO -t {cfg[threads]} >> logs/ufcg.log 2>&1; then
                    echo "[GenFlow] ERROR: ufcg profile failed for $sample" >> logs/ufcg.log
                    exit 1
                fi
                
                ucg_file="{output.profiles}/${{sample}}.ucg"
                if [ ! -f "$ucg_file" ]; then 
                    echo "Error: Expected .ucg not found: $ucg_file" >> logs/ufcg.log
                    exit 1
                fi
            done
            
            N_GENOMES=$(ls -1 {output.profiles}/*.ucg 2>/dev/null | wc -l)
            echo "[GenFlow] Number of genomes detected: $N_GENOMES" >> logs/ufcg.log
            
            if [ $N_GENOMES -lt 4 ]; then
                echo "[GenFlow] ERROR: Fungi mode requires at least 4 genomes for UFCG tree reconstruction." >> logs/ufcg.log
                exit 1
            fi
            
            echo "[GenFlow] [$(date +%H:%M:%S)] Building phylogenomic tree with UFCG..."
            TREE_METHOD="iq-tree"
            if [ "{cfg[use_raxml]}" = "True" ]; then
                TREE_METHOD="raxml"
            fi
            if ! conda run -n genflow ufcg tree -i {output.profiles} -l uid -o {output.tree_dir} -n genflow -t {cfg[threads]} -p $TREE_METHOD >> logs/ufcg.log 2>&1; then
                echo "[GenFlow] ERROR: ufcg tree failed" >> logs/ufcg.log
                exit 1
            fi
            
            TREE_FILE="{output.tree_dir}/concatenated_gsi_45.nwk"
            if [ ! -f "$TREE_FILE" ]; then
                TREE_FILE="{output.tree_dir}/concatenated.nwk"
            fi
            
            if [ -f "$TREE_FILE" ]; then
                echo ">genflow_dummy" > {output.aln}
                echo "ATCGATCG" >> {output.aln}
            else
                echo "[GenFlow] ERROR: ufcg tree did not produce expected tree file" >> logs/ufcg.log
                exit 1
            fi
            
            echo "[GenFlow] [$(date +%H:%M:%S)] UFCG profiling and tree construction complete"
            touch {output.faa} {output.fna}
            """

# UFCG UID-to-labels mapping for tree relabeling
rule create_ufcg_mappings:
    """Extract UID to label and accession mappings from UFCG JSON profiles."""
    input:
        profiles="results/ufcg/profiles"
    output:
        uid_to_label="results/ufcg/uid_to_label.json",
        uid_to_accession="results/ufcg/uid_to_accession.json"
    run:
        import json, re
        from pathlib import Path
        
        profiles_dir = Path(input.profiles)
        uid_to_label = {}
        uid_to_accession = {}
        
        for ucg_file in sorted(profiles_dir.glob("*.ucg")):
            try:
                with open(ucg_file) as f:
                    data = json.load(f)
                    genome_info = data.get('genome_info', {})
                    uid = genome_info.get('uid')
                    label = genome_info.get('label', ucg_file.stem)
                    
                    accession = label
                    match = re.search(r'(GC[FA]_\d+\.\d+)', label)
                    if match:
                        accession = match.group(1)
                    
                    if uid:
                        uid_to_label[str(uid)] = label
                        uid_to_accession[str(uid)] = accession
                        print(f"Mapped uid {uid} -> {label}")
            except Exception as e:
                print(f"Error reading {ucg_file}: {e}")
        
        Path(output.uid_to_label).parent.mkdir(parents=True, exist_ok=True)
        with open(output.uid_to_label, "w") as f:
            json.dump(uid_to_label, f, indent=2)
        with open(output.uid_to_accession, "w") as f:
            json.dump(uid_to_accession, f, indent=2)
        
        print(f"Saved mappings for {len(uid_to_label)} genomes")

# Shared rules: Alignment renaming and tree building (bacteria and fungi)
rule rename_alignment:
    """Rename FASTA headers using mappings from name_map.tsv."""
    input:
        aln="results/aligned.fasta",
        map="results/name_map.tsv"
    output:
        "results/aligned.named.fasta"
    run:
        import os
        from datetime import datetime
        
        start_time = datetime.now().strftime("%H:%M:%S")
        print(f"[GenFlow] [{start_time}] Renaming alignment headers...")
        
        if os.path.getsize(input.map) < 10:
            import shutil
            shutil.copy(input.aln, output[0])
        else:
            name_map = {}
            with open(input.map) as f:
                f.readline()
                for line in f:
                    if line.strip():
                        parts = line.rstrip().split('\t')
                        if len(parts) >= 2:
                            name_map[parts[0]] = parts[1]
            
            with open(input.aln) as inp, open(output[0], 'w') as out:
                for line in inp:
                    if line.startswith('>'):
                        hdr = line[1:].strip()
                        key = hdr.split()[0]
                        new = name_map.get(key, hdr)
                        out.write(f'>{new}\n')
                    else:
                        out.write(line)
        
        end_time = datetime.now().strftime("%H:%M:%S")
        print(f"[GenFlow] [{end_time}] Alignment headers renamed")

rule build_tree:
    """Build phylogenomic tree (IQ-TREE or RAxML) from alignment or UFCG output."""
    input: 
        aln="results/aligned.named.fasta",
        uid_to_label=lambda w: "results/ufcg/uid_to_label.json" if cfg.get("mode") == "fungi" else []
    output: "results/phylogenomic-tree.txt"
    params:
        use_raxml=lambda wildcards: str(cfg.get("use_raxml", False)),
        threads=lambda wildcards: str(cfg["threads"]),
        DNA_mode=lambda wildcards: str(cfg["DNA_mode"]),
        mode=lambda wildcards: str(cfg.get("mode", "bacteria"))
    run:
        import subprocess, json, re
        from pathlib import Path
        from datetime import datetime
        
        # Fungi mode: use UFCG tree with UID-to-label replacement
        if params.mode == "fungi":
            if Path("results/ufcg/trees/concatenated_gsi_45.nwk").exists():
                with open("results/ufcg/trees/concatenated_gsi_45.nwk") as f:
                    tree = f.read()
                
                if Path(input.uid_to_label).exists():
                    with open(input.uid_to_label) as f:
                        uid_to_label = json.load(f)
                    for uid_str, label in uid_to_label.items():
                        tree = re.sub(rf'\b{uid_str}(?=[:)])', label, tree)
                
                with open(output[0], "w") as f:
                    f.write(tree)
                
                end_time = datetime.now().strftime("%H:%M:%S")
                print(f"[GenFlow] [{end_time}] Tree built (UFCG)")
                return
            
            elif Path("results/ufcg/trees/concatenated.nwk").exists():
                with open("results/ufcg/trees/concatenated.nwk") as f:
                    tree = f.read()
                
                if Path(input.uid_to_label).exists():
                    with open(input.uid_to_label) as f:
                        uid_to_label = json.load(f)
                    for uid_str, label in uid_to_label.items():
                        tree = re.sub(rf'\b{uid_str}(?=[:)])', label, tree)
                
                with open(output[0], "w") as f:
                    f.write(tree)
                
                end_time = datetime.now().strftime("%H:%M:%S")
                print(f"[GenFlow] [{end_time}] Phylogenomic tree built from UFCG profiles")
                return
        
        # Bacteria: infer datatype and build tree
        with open(input.aln) as f:
            seqs = "".join([line.rstrip() for line in f if not line.startswith(">")])
        
        is_nuc = len([c for c in seqs if c.upper() not in "ACGTUN-."]) == 0
        datatype_arg = "" if is_nuc else " --datatype AA"
        
        if params.use_raxml == "True":
            start_time = datetime.now().strftime("%H:%M:%S")
            print(f"[GenFlow] [{start_time}] Building phylogenomic tree with RAxML...")
            cmd = f"conda run -n genflow raxml-ng --msa {input.aln} --model GTR+G --threads {params.threads} --tree pars{datatype_arg} --redo --prefix results/raxml_tree"
            subprocess.run(cmd, shell=True, check=True)
            import shutil
            shutil.copy("results/raxml_tree.raxml.bestTree", output[0])
        else:
            start_time = datetime.now().strftime("%H:%M:%S")
            print(f"[GenFlow] [{start_time}] Building phylogenomic tree with IQ-TREE...")
            if is_nuc or params.DNA_mode == "True":
                cmd = f"conda run -n genflow iqtree -s {input.aln} -m GTR+G -T {params.threads} -B 1000 -alrt 1000 --prefix results/iqtree -quiet"
            else:
                cmd = f"conda run -n genflow iqtree -s {input.aln} -m LG+G -T {params.threads} -B 1000 -alrt 1000 --prefix results/iqtree -quiet"
            subprocess.run(cmd, shell=True, check=True)
            import shutil
            shutil.copy("results/iqtree.contree", output[0])
        
        end_time = datetime.now().strftime("%H:%M:%S")
        print(f"[GenFlow] [{end_time}] Phylogenomic tree built")

# ANI analysis (optional)
if cfg.get("run_ani", False):
    rule ani_prepare:
        """Copy FASTA files into dedicated folder and create sample labels for pyANI."""
        input: 
            collected="Intermediate/.collected",
            tree="results/phylogenomic-tree.txt",  
            ncbi_done=lambda w: "logs/ncbi_renamed.done" if cfg.get("use_ncbi_download") else []
        output:
            labels="results/labels.txt",
            fasta_dir=directory("results/fasta_files")
        run:
            import os, glob, shutil, pathlib
            os.makedirs("results/fasta_files", exist_ok=True)
            fas = sorted(glob.glob("Intermediate/*.fasta")) + sorted(glob.glob("Intermediate/*.fa")) + sorted(glob.glob("Intermediate/*.fna"))
            if not fas:
                raise SystemExit("No FASTA available for ANI.")
            for f in fas:
                dst = pathlib.Path("results/fasta_files") / (pathlib.Path(f).stem + ".fa")
                shutil.copy2(f, dst)
            paths = sorted(glob.glob("results/fasta_files/*.fa"))
            with open(output.labels, "w") as L:
                for p in paths:
                    stem = pathlib.Path(p).stem
                    L.write(f"{stem}\n")

    rule ani_run:
        """Compute average nucleotide identity using pyANI."""
        input:
            labels="results/labels.txt",
            fasta_dir="results/fasta_files"
        output:
            "results/pyANI/ANIm_percentage_identity.tab"
        shell:
            r"""
            set -euo pipefail
            rm -rf results/pyANI
            mkdir -p results/pyANI
            echo "[GenFlow] [$(date +%H:%M:%S)] Running ANI analysis..."
            if ! conda run -n genflow average_nucleotide_identity.py \
                -i results/fasta_files \
                -o results/pyANI \
                --labels {input.labels} \
                -g --gmethod seaborn --gformat svg,png -v -l logs/pyANI.log \
                --force --workers {cfg[threads]} 2>&1; then
                echo ""
                echo "[GenFlow] ANI ANALYSIS FAILED"
                echo "Reason: Genomes are too divergent"
                echo "ANI requires genomes with significant sequence similarity"
                echo "Current genomes are too different to produce alignments"
                echo ""
                touch results/pyANI/ANIm_percentage_identity.tab
            else
                echo "[GenFlow] [$(date +%H:%M:%S)] ANI analysis complete"
            fi
            """
    rule ani_ggplot:
        """Generate ANI heatmap visualization with ggplot2."""
        input: "results/pyANI/ANIm_percentage_identity.tab"
        output: 
            "results/ani_heatmap.pdf",
            "results/ani_heatmap.png"
        shell:
            r"""
            set -euo pipefail
            echo "[GenFlow] Generating ANI heatmap with ggplot2..."
            if [ -s {input} ] && [ $(wc -c < {input}) -gt 100 ]; then
                conda run -n genflow Rscript scripts/ANI.R results/pyANI/ANIm_percentage_identity.tab
                echo "[GenFlow] ANI ggplot2 visualization complete"
            else
                echo "[GenFlow] ANI analysis produced no valid data - skipping heatmap"
                touch results/ani_heatmap.pdf results/ani_heatmap.png
            fi
            """

    rule ani_all:
        """Aggregate ANI outputs for the pipeline."""
        input: 
            tree="results/phylogenomic-tree.txt",
            ani_tab="results/pyANI/ANIm_percentage_identity.tab",
            ani_pdf="results/ani_heatmap.pdf",
            ani_png="results/ani_heatmap.png"
        output: touch("results/.ani.done")
        shell: "echo 'ANI analysis complete' > /dev/null"



