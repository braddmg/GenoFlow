# 2) NCBI genome download
rule ncbi_download:
    """Download reference genomes using NCBI datasets + unzip to Intermediate/."""
    input:
        "Intermediate/.collected"
    output:
        touch("logs/download.done")
    shell:
        r"""
        set -euo pipefail
        echo "[GenFlow] [$(date +%H:%M:%S)] Downloading genomes from NCBI..."
        mkdir -p Intermediate
        grep -v '^\s*#' {cfg[genomes]} | sed '/^\s*$/d' > Intermediate/genomes.clean.txt
        if [ ! -s Intermediate/genomes.clean.txt ]; then
            echo "Error: No valid accessions found in {cfg[genomes]}" >> logs/download.log
            exit 1
        fi
        conda run -n genflow datasets download genome accession \
            --inputfile Intermediate/genomes.clean.txt >> logs/download.log 2>&1
        unzip -o 'ncbi_*.zip' >> logs/download.log 2>&1
        mkdir -p Intermediate
        mv ncbi_dataset/data/GC*/*.fna Intermediate/ || true
        rm -rf ncbi_dataset *.zip md5sum.txt README.md || true
        echo "[GenFlow] [$(date +%H:%M:%S)] NCBI genomes downloaded"
        """

rule ncbi_rename_with_species:
    """Rename downloaded NCBI files with organism names from EDirect."""
    input:
        "logs/download.done"
    output:
        touch("logs/ncbi_renamed.done")
    shell:
        r"""
        set +e
        echo "[GenFlow] [$(date +%H:%M:%S)] Renaming NCBI files with organism names..."
        cd Intermediate
        
        EDIRECT="{cfg[edirect_dir]}"
        
        > ncbi_names.txt
        for f in GCF_* GCA_*; do
            [ ! -f "$f" ] && continue
            [ -d "$f" ] && continue
            
            term=$(echo "$f" | cut -f1,2 -d'_')
            
            result=$("$EDIRECT/esearch" -db assembly -query "$term" 2>/dev/null | \
                     "$EDIRECT/esummary" 2>/dev/null | \
                     "$EDIRECT/xtract" -pattern DocumentSummary -sep ' ' -element Organism,Strain,AssemblyAccession 2>/dev/null | head -1)
            
            organism_clean=$(echo "$result" | sed 's/ /_/g; s/://g; s+/+_+g; s/,/_/g; s/\./_/g; s/-/_/g; s/_([^)(]*)//g; s/=//g; s/[;]//g; s/([^)(]*)//g; s/[(]//g; s/[)]//g; s/__/_/g')
            
            if [ -z "$organism_clean" ]; then
                organism_clean=$(echo "$f" | sed 's/.fna$//')
            fi
            
            echo "$f	$organism_clean" >> ncbi_names.txt
        done
        
        while IFS=$'\t' read -r oldname newname; do
            [ -z "$oldname" ] && continue
            if [ -f "$oldname" ]; then
                mv "$oldname" "$newname.fna" 2>/dev/null || true
            fi
        done < ncbi_names.txt
        
        cd - > /dev/null
        set -e
        echo "[GenFlow] [$(date +%H:%M:%S)] NCBI files renamed with organism names"
        """

if cfg["use_ncbi_download"]:
    downstream_flag = ["Intermediate/.collected", "logs/download.done", "logs/ncbi_renamed.done"]
else:
    downstream_flag = "Intermediate/.collected"

rule generate_name_map:
    """Combine all FASTA and generate individual sequence identifier mappings."""
    input:
        downstream_flag
    output:
        combined="results/combined.fasta",
        name_map="results/name_map.tsv"
    run:
        from datetime import datetime
        start_time = datetime.now().strftime("%H:%M:%S")
        print(f"[GenFlow] [{start_time}] Generating sequence identifiers...")
        combine_fastas(output.combined)
        end_time = datetime.now().strftime("%H:%M:%S")
        print(f"[GenFlow] [{end_time}] Sequence identifiers generated from FASTA files")
        generate_individual_sequence_names(output.combined, output.name_map)

# Bacteria workflow: Prokka + Roary annotation and pangenome analysis
if cfg["mode"] == "bacteria":

    rule annotate_prokka:
        """Annotate bacterial genomes with Prokka."""
        input:
            name_map="results/name_map.tsv"
        output:
            touch("logs/prokka.done")
        shell:
            r"""
            set -euo pipefail
            mkdir -p results/prokka logs
            echo "[GenFlow] [$(date +%H:%M:%S)] Running Prokka annotations..."
            shopt -s nullglob
            
            total=0
            for f in Intermediate/*.fasta Intermediate/*.fa Intermediate/*.fna; do
                [ -f "$f" ] && total=$((total+1))
            done
            
            current=0
            for f in Intermediate/*.fasta Intermediate/*.fa Intermediate/*.fna; do
                [ -f "$f" ] || continue
                current=$((current+1))
                base=$(basename "$f")
                base=${{base%.fasta}}
                base=${{base%.fa}}
                base=${{base%.fna}}
                echo "[GenFlow] [Prokka] [$current/$total] Annotating $base"
                echo "  → Annotating $base" >> logs/prokka.log
                conda run -n genflow prokka \
                    --outdir results/prokka/$base \
                    --prefix $base \
                    --centre X --compliant \
                    --cpus {cfg[threads]} \
                    --force "$f" >> logs/prokka.log 2>&1 || exit 1
            done
            echo "[GenFlow] [$(date +%H:%M:%S)] Prokka genome annotations completed"
            """

    rule rename_prokka_gff:
        """Rename sequence identifiers in Prokka GFF outputs using name_map."""
        input:
            prokka_done="logs/prokka.done",
            name_map="results/name_map.tsv"
        output:
            touch("logs/rename_gff.done")
        run:
            import glob, os
            import pathlib
            from datetime import datetime
            
            start_time = datetime.now().strftime("%H:%M:%S")
            print(f"[GenFlow] [{start_time}] Renaming sequence IDs in GFF files...")
            
            output_dir = pathlib.Path("results/prokka_renamed")
            output_dir.mkdir(parents=True, exist_ok=True)
            
            gff_files = glob.glob("results/prokka/*/*.gff")
            if not gff_files:
                raise SystemExit("No Prokka GFF files found!")
            
            for gff_file in gff_files:
                basename = os.path.basename(gff_file)
                output_file = output_dir / basename
                rename_sequences_in_gff(gff_file, input.name_map, str(output_file))
            
            end_time = datetime.now().strftime("%H:%M:%S")
            print(f"[GenFlow] [{end_time}] GFF sequence IDs renamed")

    rule pangenome_roary:
        """Compute pangenome and core gene alignment using Roary."""
        input:
            gff_done="logs/rename_gff.done"
        output:
            "results/core_gene_alignment.aln"
        shell:
            r"""
            mkdir -p results/roary logs
            echo "[GenFlow] [$(date +%H:%M:%S)] Running Roary pangenome analysis..."
            GFFS=$(ls results/prokka_renamed/*.gff 2>/dev/null || true)
            
            if [ -z "$GFFS" ]; then
                echo "Error: No Prokka GFFs found under results/prokka_renamed." >> logs/roary.log
                exit 1
            fi
            
            conda run -n genflow-roary roary -e --mafft -p {cfg[threads]} -f results/roary $GFFS >> logs/roary.log 2>&1 || true

            if [ -f results/roary/core_gene_alignment.aln ]; then
                ROARY_DIR=results/roary
            else
                ROARY_DIR=$(ls -td results/roary_* 2>/dev/null | head -n1 || true)
            fi

            if [ -z "$ROARY_DIR" ]; then
                echo "Error: No Roary output directory found." >> logs/roary.log
                exit 1
            fi

            if [ -f "$ROARY_DIR/core_gene_alignment.aln" ]; then
                cp "$ROARY_DIR/core_gene_alignment.aln" {output}
            elif [ -f "$ROARY_DIR/core_gene_alignment.aln.gz" ]; then
                gunzip -c "$ROARY_DIR/core_gene_alignment.aln.gz" > {output}
            else
                echo "Error: core_gene_alignment.aln not found." >> logs/roary.log
                exit 1
            fi
            echo "[GenFlow] [$(date +%H:%M:%S)] Roary pangenome analysis completed"
            """

